# Docsie production build API. Store the key only in your untracked .env file.
DOCSIE_BASE_URL=https://app.docsie.io
DOCSIE_DEPLOYMENT_ID=deployment_EFk3AIigMh599HRk6
DOCSIE_DEPLOYMENT_TYPE=portal
DOCSIE_API_KEY=

# Offline-safe reader plugins. Search is included explicitly for the demo.
DOCSIE_PLUGINS_JSON='["codehelpers","lightbox","meta","scrollspy","toprint","darkmode","search"]'

# Portable local runtime included in every generated ZIP.
AIRGAP_PORT=8091

# Polling limits for the asynchronous Celery build.
AIRGAP_POLL_INTERVAL_SECONDS=5
AIRGAP_POLL_TIMEOUT_SECONDS=1800
