# Docsie build API (the demo uses staging to avoid mutating production).
DOCSIE_BASE_URL=https://staging.docsie.io
DOCSIE_DEPLOYMENT_ID=deployment_EFk3AIigMh599HRk6
DOCSIE_DEPLOYMENT_TYPE=portal
DOCSIE_API_KEY=

# Offline-safe reader plugins. Search is added by the build service automatically.
DOCSIE_PLUGINS_JSON='["codehelpers","lightbox","meta","scrollspy","toprint","darkmode"]'

# Local isolated runtime.
AIRGAP_PORT=8088
AIRGAP_CONTAINER_NAME=docsie-help-offline
AIRGAP_GATEWAY_CONTAINER_NAME=docsie-help-offline-gateway
AIRGAP_IMAGE_NAME=docsie-help-offline:demo
AIRGAP_NETWORK_NAME=docsie-airgap-internal

# Polling limits for the asynchronous Celery build.
AIRGAP_POLL_INTERVAL_SECONDS=5
AIRGAP_POLL_TIMEOUT_SECONDS=1800
